# ============================================================
# 后端环境变量模板 —— 只有占位符，不含真实密钥，必须提交到仓库。
# 使用方法：Copy-Item .env.example .env，再填写自己的真实值。
# ============================================================

PORT=3000

# 大模型服务选择：本实验使用在线方案 bailian（阿里百炼）。
# 切换模型服务只改这一行并重启后端，前端代码无需修改。
LLM_PROVIDER=bailian

# ---------- 阿里百炼（DashScope）OpenAI 兼容接口 ----------
# 在百炼控制台创建 API Key 后填入这里；
# 真实 Key 只能写入后端 .env，绝不能硬编码、绝不能提交到仓库。
# 模型名请填写自己在控制台已开通、可用的模型。
DASHSCOPE_API_KEY=填写自己的真实Key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.8-flash

# ---------- MySQL 实验数据库（第 5 讲新增） ----------
# 填写本机实际可用的账号与密码；campus_assistant 是本文使用的实验库名。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD="请填写实际密码"
MYSQL_DATABASE=campus_assistant

# ---------- 上下文记忆策略（第 5 讲新增） ----------
# window：只发送近期完整问答；summary：早期问答压缩成摘要后再发送。
CONTEXT_STRATEGY=window
CONTEXT_RECENT_TURNS=4
CONTEXT_WINDOW_TOKENS=32768
MODEL_MAX_OUTPUT_TOKENS=2048

# ---------- RAG 嵌入服务与 Chroma（第 6 讲新增） ----------
# 回答模型配置保持独立；嵌入模型在 Ollama 中运行。
RAG_EMBEDDING_URL=http://127.0.0.1:11434
RAG_EMBEDDING_MODEL=bge-m3
RAG_CHROMA_PORT=8006
RAG_COLLECTION=campus-assistant

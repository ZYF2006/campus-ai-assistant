# ============================================================
# 后端环境变量模板 —— 只有占位符，不含真实密钥，必须提交到仓库。
# 使用方法：Copy-Item .env.example .env，再填写自己的真实值。
# ============================================================

PORT=3000

# 大模型服务选择：本实验使用在线方案 bailian（阿里百炼）。
# 切换模型服务只改这一行并重启后端，前端代码无需修改。
LLM_PROVIDER=bailian

# ---------- 阿里百炼（DashScope）OpenAI 兼容接口 ----------
# 在百炼控制台创建 API Key 后填入这里；
# 真实 Key 只能写入后端 .env，绝不能硬编码、绝不能提交到仓库。
# 模型名请填写自己在控制台已开通、可用的模型。
DASHSCOPE_API_KEY=填写自己的真实Key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=glm-5.1

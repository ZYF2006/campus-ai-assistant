# 本文件的目的是让 pnpm 的缓存/全局目录落在项目目录之外，避免缓存产物
# 被 Prettier、ESLint、Git 扫描，也避免它们出现在项目结构截图里。
#
# 说明：store-dir 使用盘符根目录下的 pnpm-store；如需改到别处，
# 修改下面的路径即可（Windows 请使用正斜杠或双反斜杠）。
store-dir=D:/pnpm-store

# 让 pnpm 自身管理 packageManager 字段指定的版本，所需的全局目录同样放到项目外。
global-dir=D:/pnpm-store/global

# 依赖安装脚本（esbuild 等）需要联网下载二进制时的镜像地址，可按需删除。
registry=https://registry.npmmirror.com
